{
  "name": "escola-nail",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de formacao profissional em manicure e nail design: funil, checkout e EAD. Conteudo pedagogico ainda nao definido - toda a estrutura e editavel pelo painel.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:seed": "supabase db reset --no-backup",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "db:lint": "supabase db lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "homolog:up": "powershell -ExecutionPolicy Bypass -File scripts/homolog/iniciar-banco.ps1",
    "homolog:down": "powershell -ExecutionPolicy Bypass -File scripts/homolog/iniciar-banco.ps1 -Parar",
    "validar": "node scripts/homolog/01-migrations.mjs && node scripts/homolog/02-constraints.mjs && node scripts/homolog/03-liberacao.mjs && node scripts/homolog/04-rls.mjs && node scripts/homolog/05-quiz.mjs && node scripts/homolog/06-e2e.mjs && node scripts/homolog/10-formacao.mjs",
    "screenshots": "node scripts/screenshots.mjs http://localhost:3117 depois",
    "storage:preflight": "node scripts/storage/preflight.mjs",
    "storage:validate": "node scripts/storage/validate.mjs",
    "diag:toque": "node scripts/diag-alvos-toque.mjs",
    "deploy:schema": "node scripts/deploy/aplicar-migrations.mjs",
    "deploy:admin": "node scripts/deploy/promover-admin.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "mercadopago": "^2.0.15",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tus-js-client": "^4.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^25.0.1",
    "pg": "^8.22.0",
    "pg15": "npm:@embedded-postgres/windows-x64@^15.18.0-beta.17",
    "playwright": "^1.62.0",
    "supabase": "^1.207.9",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.5"
  }
}
