# ---------------------------------------------------------------------------
# Copie para .env.local e preencha. .env.local esta no .gitignore.
# Todos os valores abaixo sao EXEMPLOS FICTICIOS.
# Nenhum valor real pode ser commitado nem aparecer em relatorio ou screenshot.
# ---------------------------------------------------------------------------

# --- Aplicacao -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# --- Supabase --------------------------------------------------------------
# Painel do projeto > Project Settings > API Keys
# Use um projeto EXCLUSIVO DE HOMOLOGACAO. Nunca o de producao.
#
# O Supabase tem HOJE dois formatos de chave, e a aplicacao aceita os dois.
# Preencha UM dos pares abaixo — nao precisa dos quatro.
#
#   FORMATO NOVO (recomendado em projeto criado a partir de 2025)
#     sb_publishable_...  chave publica, curta, vai para o navegador
#     sb_secret_...       chave de backend, curta, NAO e um JWT
#
#   FORMATO LEGADO (projetos antigos)
#     anon          JWT longo, vai para o navegador
#     service_role  JWT longo, NUNCA vai para o navegador
#
# ATENCAO: nao julgue a validade pelo tamanho. Uma sb_secret_ legitima tem
# menos de 60 caracteres. O que invalida uma chave e ela ser valor de exemplo.
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co

# Chave PUBLICA — preencha uma das duas.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_troque_por_valor_real
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo.anon

# Chave de BACKEND — preencha uma das duas.
# NUNCA exponha no navegador. So em rota de servidor, webhook e cron.
# Se estiver num nome NEXT_PUBLIC_*, ela VAZA: o pre-voo acusa isso.
SUPABASE_SECRET_KEY=sb_secret_troque_por_valor_real
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo.service

# String de conexao direta, usada pelo CLI nas migrations
SUPABASE_DB_URL=postgresql://postgres.abcdefghijklmnop:TROQUE_PELA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Marque explicitamente que este projeto e de homologacao. Sem isto, o
# pre-voo pode classificar o ambiente como producao e recusar a validacao.
SUPABASE_HOMOLOG=1

# Token pessoal do CLI (supabase login). So no ambiente de quem opera.
SUPABASE_ACCESS_TOKEN=sbp_exemplo0000000000000000000000000000

# --- Mercado Pago ----------------------------------------------------------
# Credenciais de PRODUCAO e de TESTE sao diferentes. Comece pelas de TESTE.
# O access token NUNCA vai para o navegador.
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-exemplo-000000000
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
# Segredo da assinatura do webhook (Mercado Pago > Webhooks > Configurar)
MERCADOPAGO_WEBHOOK_SECRET=exemplo_segredo_do_webhook
# URL absoluta que o Mercado Pago chama. Em dev, use um tunel (ex.: ngrok).
MERCADOPAGO_NOTIFICATION_URL=https://exemplo.ngrok.app/api/webhooks/mercadopago

# --- WhatsApp --------------------------------------------------------------
# Numero no formato internacional, apenas digitos. Ex.: 5511999999999
# PENDENTE: numero oficial ainda nao informado pela responsavel.
# Enquanto estiver vazio, todo botao de WhatsApp desaparece do site.
WHATSAPP_NUMBER=

# --- Seguranca -------------------------------------------------------------
# Gere cada um com: openssl rand -hex 32
# Segredo dos tokens de pre-visualizacao de rascunho do CMS.
CMS_PREVIEW_SECRET=troque_por_32_bytes_aleatorios_em_hex
# Segredo dos tokens do resultado do diagnostico.
DIAGNOSTIC_SECRET=troque_por_32_bytes_aleatorios_em_hex
# Segredo do cron que publica conteudo agendado.
CRON_SECRET=troque_por_32_bytes_aleatorios_em_hex

# ---------------------------------------------------------------------------
# COMO CONFERIR SE ESTA TUDO CERTO
#
#   npm run storage:preflight   confere presenca e formato SEM imprimir valor
#   npm run storage:validate    prova real: sobe um MP4 de teste, retoma o
#                               envio, liga a aula, entrega por URL assinada e
#                               confirma que aluna sem matricula NAO acessa.
#                               Recusa-se a rodar com valor de exemplo.
#
# O que NUNCA pode acontecer: chave secreta colada em mensagem, documentacao,
# issue, log de CI ou captura de tela. Ela vai no .env.local (que esta no
# .gitignore) ou no gerenciador de segredos do ambiente.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# APENAS PARA TESTES LOCAIS (nunca em producao)
#
# Aponta os scripts de scripts/homolog/ para outro PostgreSQL.
#   PGHOMOLOG_PORT=55432  -> PostgreSQL 18.4 embarcado
#   PGHOMOLOG_PORT=55433  -> PostgreSQL 15.18 embarcado (linha do Supabase)
#   PGHOMOLOG_URL=...     -> banco externo, ex.: Supabase de homologacao
# ---------------------------------------------------------------------------
# PGHOMOLOG_PORT=55432
# PGHOMOLOG_URL=
